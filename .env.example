# Copy to .env (git-ignored). Only GROQ_API_KEY is required.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Where the Streamlit app finds the complaint API
COMPLAINTS_API_URL=http://127.0.0.1:8000

# Where the API keeps its SQLite file
COMPLAINTS_DB_PATH=complaints.db

# Knowledge base folder (PDFs) and embedding model
KNOWLEDGE_DIR=knowledge_base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
